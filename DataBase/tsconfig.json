{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "uploads"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
